{
  "name": "digitalogic/digitalogic-wp",
  "description": "WordPress/WooCommerce plugin for dynamic pricing, stock management, and POS integration for Digitalogic electronic components shop",
  "type": "wordpress-plugin",
  "keywords": [
    "wordpress",
    "woocommerce",
    "plugin",
    "dynamic-pricing",
    "stock-management",
    "e-commerce"
  ],
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Digitalogic Team"
    }
  ],
  "require": {
    "php": ">=8.3",
    "laravel/framework": "^13.0",
    "phpoffice/phpspreadsheet": "^5.9"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5",
    "wp-coding-standards/wpcs": "^3.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Digitalogic\\Laravel\\": "laravel/app/"
    },
    "classmap": [
      "includes/"
    ],
    "files": [
      "laravel/app/helpers.php"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": [
        "*"
      ]
    }
  },
  "scripts": {
    "post-autoload-dump": "@php laravel/prepare-runtime.php",
    "test": "phpunit",
    "phpcs": "phpcs --standard=WordPress --extensions=php .",
    "phpcbf": "phpcbf --standard=WordPress --extensions=php .",
    "lint": [
      "@phpcs"
    ]
  },
  "config": {
    "autoloader-suffix": "DigitalogicWp",
    "platform": {
      "php": "8.3.0"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
